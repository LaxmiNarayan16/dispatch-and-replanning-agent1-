# PostgreSQL/Neon connection string. Never commit a real credential.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# IANA timezone used when the API interprets dispatcher-entered local times.
OPERATIONAL_TIMEZONE="Asia/Kolkata"

# Optional: enables the advisory AI planning agent. Without these values the
# deterministic validated plan is returned with a warning.
GEMINI_API_KEY=""
# Example: gemini-3.6-flash. Any model that supports structured JSON output works.
GEMINI_MODEL=""

# At least 32 unpredictable characters. Generate and store only in Vercel/your private .env.
AUTH_SECRET=""
