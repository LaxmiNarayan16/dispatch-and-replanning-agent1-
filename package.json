{
  "name": "field-service-dispatch-and-replanning-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic single-day field-service dispatch and replanning foundation.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --env-file=.env node_modules/tsx/dist/cli.mjs watch src/api/server.ts",
    "start:api": "node dist/api/server.js",
    "build": "tsc --project tsconfig.json",
    "build:web": "vite build",
    "build:vercel": "prisma generate && tsc --noEmit --project tsconfig.serverless.json && vite build",
    "check": "tsc --noEmit --project tsconfig.json",
    "check:serverless": "tsc --project tsconfig.serverless.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "6.17.0",
    "express": "5.1.0",
    "lucide-react": "0.468.0",
    "pino": "9.7.0",
    "pino-http": "10.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "@types/express": "5.0.3",
    "@types/node": "22.15.3",
    "prisma": "6.17.0",
    "supertest": "7.1.1",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "@types/supertest": "6.0.2",
    "vite": "5.4.11"
  }
}
